{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pcc-game-day",
  // The club's Cloudflare account: custom domains need the Worker and the parklandscricket.co.nz zone in one account.
  "account_id": "0e8ee95956eccb89203d31cf3fca2606",
  "main": "api/src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "gameday.parklandscricket.co.nz", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./web/build",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "pcc-game-day", "database_id": "8c555010-55c8-4a70-9819-d354210728d1", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "pcc-game-day-photos" }],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "4cdb424dc09b4336a06f194fbf5bb15d" }],
  "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "REFRESH_LIMIT", "namespace_id": "1002", "simple": { "limit": 1, "period": 60 } },
    { "name": "ADMIN_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ],
  "triggers": { "crons": ["0 14 * * *"] },
  "vars": {
    "PLAYHQ_TENANT": "nzc",
    "PLAYHQ_ORG_ID": "73ce5541-a7ac-457a-a912-d6408aa96a74",
    "PLAYHQ_BASE_URL": "https://api.playhq.com"
  },
  "observability": { "enabled": true },

  // Demo: last season (2025/26) with the clock frozen at the final Saturday. Deploy with `--env demo`.
  "env": {
    "demo": {
      "name": "pcc-game-day-demo",
      "routes": [{ "pattern": "gameday-demo.parklandscricket.co.nz", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB", "database_name": "pcc-game-day-demo", "database_id": "6d415bdd-f044-48b4-ab05-f5898718eec3", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "pcc-game-day-demo-photos" }],
      "kv_namespaces": [{ "binding": "CONFIG", "id": "90d064e8d6444048a016999529fc4dd4" }],
      "ratelimits": [
        { "name": "WRITE_LIMIT", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "REFRESH_LIMIT", "namespace_id": "2002", "simple": { "limit": 1, "period": 60 } },
        { "name": "ADMIN_LIMIT", "namespace_id": "2003", "simple": { "limit": 5, "period": 60 } }
      ],
      "triggers": { "crons": ["0 14 * * *"] },
      "vars": {
        "PLAYHQ_TENANT": "nzc",
        "PLAYHQ_ORG_ID": "73ce5541-a7ac-457a-a912-d6408aa96a74",
        "PLAYHQ_BASE_URL": "https://api.playhq.com",
        "FAKE_NOW": "2026-03-21T08:00:00Z"
      }
    }
  }
}
