{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pcc-game-day",
  "main": "api/src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./web/build",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "pcc-game-day", "database_id": "c6048a56-7638-4c82-aafb-8c9baf840ce3", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "pcc-game-day-photos" }],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "0e3a0b0b495a4e43bdfee18ab1aee82f" }],
  "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "REFRESH_LIMIT", "namespace_id": "1002", "simple": { "limit": 1, "period": 60 } },
    { "name": "ADMIN_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ],
  "triggers": { "crons": ["0 14 * * *"] },
  "vars": {
    "PLAYHQ_TENANT": "nzc",
    "PLAYHQ_ORG_ID": "73ce5541-a7ac-457a-a912-d6408aa96a74",
    "PLAYHQ_BASE_URL": "https://api.playhq.com"
  },
  "observability": { "enabled": true },

  // Demo: last season (2025/26) with the clock frozen at the final Saturday. Deploy with `--env demo`.
  "env": {
    "demo": {
      "name": "pcc-game-day-demo",
      "d1_databases": [
        { "binding": "DB", "database_name": "pcc-game-day-demo", "database_id": "02c8311d-68b7-48f5-b8b1-2ba829f21d60", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "pcc-game-day-demo-photos" }],
      "kv_namespaces": [{ "binding": "CONFIG", "id": "f03102f995f44b3982765fe8a81855ba" }],
      "ratelimits": [
        { "name": "WRITE_LIMIT", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "REFRESH_LIMIT", "namespace_id": "2002", "simple": { "limit": 1, "period": 60 } },
        { "name": "ADMIN_LIMIT", "namespace_id": "2003", "simple": { "limit": 5, "period": 60 } }
      ],
      "triggers": { "crons": ["0 14 * * *"] },
      "vars": {
        "PLAYHQ_TENANT": "nzc",
        "PLAYHQ_ORG_ID": "73ce5541-a7ac-457a-a912-d6408aa96a74",
        "PLAYHQ_BASE_URL": "https://api.playhq.com",
        "FAKE_NOW": "2026-03-21T08:00:00Z"
      }
    }
  }
}
